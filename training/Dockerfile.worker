FROM pytorch/pytorch:2.3.0-cuda12.1-cudnn8-runtime

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    ffmpeg \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --upgrade pip && pip install -r requirements.txt

COPY . .

RUN mkdir -p /app/data/datasets /app/data/uploads \
    /app/data/models /app/data/exports /app/data/logs \
    /app/inference_models
RUN useradd -m -u 1001 trainer && chown -R trainer:trainer /app
USER trainer

CMD ["celery", "-A", "app.celery_app", "worker", \
     "--loglevel=info", \
     "--queues=gpu,cpu", \
     "--concurrency=1", \
     "--hostname=gpu-worker@%h"]
