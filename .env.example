# ─── Security (REQUIRED — change in production) ────────────────────
APP_ENV=development
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
INITIAL_ADMIN_EMAIL=admin@bevp.local
INITIAL_ADMIN_PASSWORD=replace-this-password
POSTGRES_PASSWORD=replace-this-database-password
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# ─── Inference API ────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8100
NEXT_PUBLIC_WS_URL=ws://localhost:8100

# ─── Training API ─────────────────────────────────────────────────
NEXT_PUBLIC_TRAINING_API_URL=http://localhost:8101
NEXT_PUBLIC_TRAINING_WS_URL=ws://localhost:8101

# ─── Alerts (optional) ────────────────────────────────────────────
WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── SMTP (optional) ──────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ─── Storage ─────────────────────────────────────────────────────
STORAGE_PATH=/app/storage
# Recorded video uploads (default: 2 GiB)
MAX_VIDEO_UPLOAD_BYTES=2147483648
